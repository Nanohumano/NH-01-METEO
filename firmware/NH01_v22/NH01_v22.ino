// Dibuja un logo pixel a pixel; 0x0000 es transparente (deja ver el fondo)
void dibujarLogo(const uint16_t* img, int lado, int x, int y) {
  for (int j = 0; j < lado; j++)
    for (int i = 0; i < lado; i++) {
      uint16_t c = pgm_read_word(&img[j * lado + i]);
      if (c) tft.drawPixel(x + i, y + j, c);
    }
}
