void sol(int x, int y) {
  tft.fillCircle(x, y, 11, TFT_YELLOW);
  for (int a = 0; a < 360; a += 45) {
    float rad = a * 0.0174532925f;
    tft.drawLine(x + (int)(15 * cosf(rad)), y + (int)(15 * sinf(rad)),
                 x + (int)(20 * cosf(rad)), y + (int)(20 * sinf(rad)), TFT_ORANGE);
  }
}
